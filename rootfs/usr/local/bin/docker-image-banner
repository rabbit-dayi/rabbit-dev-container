#!/bin/bash
set -u

case "${STARTUP_BANNER:-true}" in
    true|1|yes|on) ;;
    false|0|no|off) exit 0 ;;
    *)
        printf '%s\n' '[startup-banner] Ignoring unsupported STARTUP_BANNER value.' >&2
        ;;
esac

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    accent=$'\033[38;5;45m'
    bold=$'\033[1;38;5;255m'
    muted=$'\033[38;5;245m'
    reset=$'\033[0m'
else
    accent=''
    bold=''
    muted=''
    reset=''
fi

feature_status() {
    case "${1:-}" in
        true|1|yes|on) printf 'on' ;;
        false|0|no|off) printf 'off' ;;
        *) printf 'default' ;;
    esac
}

row() {
    printf '%b\n' "${accent}|${reset}  $1"
}

display_host="${NGINX_SERVER_NAMES:-localhost}"
display_host="${display_host%%,*}"
[ "$display_host" = '_' ] && display_host='localhost'
if [[ "$display_host" =~ [^A-Za-z0-9.*_-] ]]; then
    display_host='configured-host'
fi

https_port="${NGINX_HTTPS_PORT:-443}"
[[ "$https_port" =~ ^[0-9]{1,5}$ ]] || https_port=443

nginx_status="$(feature_status "${NGINX_ENABLE:-true}")"
if [ "$nginx_status" = 'on' ]; then
    web_entry="https://${display_host}:${https_port}/services/"
    status_entry="https://${display_host}:${https_port}/status/"
    if [ "${RESOLV_WEB_ENABLE:-true}" = true ] \
        && { [ -n "${RESOLV_WEB_PASSWORD:-${PASSWORD:-}}" ] \
            || [ "${RESOLV_WEB_ALLOW_UNAUTHENTICATED:-false}" = true ]; }; then
        dns_entry="https://${display_host}:${https_port}/dns/"
    else
        dns_entry='disabled'
    fi
else
    web_entry='disabled (set NGINX_ENABLE=true to enable)'
    status_entry='disabled'
    dns_entry='disabled'
fi

service_count=0
if [ -n "${NGINX_SERVICE_LINKS:-}" ]; then
    IFS=';' read -r -a service_entries <<<"${NGINX_SERVICE_LINKS}"
    service_count="${#service_entries[@]}"
fi

# Plugin counts are derived generically from the registry (see
# rootfs/etc/rabbit-plugins/registry.json) so a new plugin doesn't need a
# named row here the way DIND/TAILSCALE do.
plugin_registry_file="${PLUGIN_REGISTRY_FILE:-/etc/rabbit-plugins/registry.json}"
plugin_total=0
plugin_enabled=0
plugin_web_enabled=0
if [ -r "$plugin_registry_file" ]; then
    while IFS=$'\t' read -r plugin_id plugin_enable_env plugin_web_path; do
        [ -n "$plugin_id" ] || continue
        plugin_total=$((plugin_total + 1))
        enabled_value="${!plugin_enable_env:-false}"
        if [ "$enabled_value" = true ]; then
            plugin_enabled=$((plugin_enabled + 1))
            if [ -n "$plugin_web_path" ] && [ "$plugin_web_path" != "null" ]; then
                plugin_web_enabled=$((plugin_web_enabled + 1))
            fi
        fi
    done < <(jq -r '.[] | [.id, .enable_env, (.web_path // "null")] | @tsv' "$plugin_registry_file" 2>/dev/null)
fi
service_count=$((service_count + plugin_web_enabled))

printf '%b\n' "${accent}+------------------------------------------------------------+${reset}"
printf '%b\n' "${accent}|${reset}  ${bold}RABBIT DEV CONTAINER 🐇${reset}  ${muted}:: REMOTE DEV GATEWAY${reset}"
printf '%b\n' "${accent}|${reset}  ${muted}boot sequence initialized${reset}"
row "SSH       ssh://root@${display_host}:22"
row "WEB       ${web_entry}"
row "STATUS    ${status_entry}"
row "DNS       ${dns_entry}"
row "WORKSPACE /workspace"
row "SERVICES  ${service_count} custom route(s)  |  SSHFS/rclone ready"
row "DIND      $(feature_status "${DOCKERD_ROOTLESS_ENABLE:-false}")  |  TAILSCALE $(feature_status "${TS_ENABLE:-false}")"
row "PLUGINS   ${plugin_enabled}/${plugin_total} enabled"
printf '%b\n' "${accent}+------------------------------------------------------------+${reset}"
